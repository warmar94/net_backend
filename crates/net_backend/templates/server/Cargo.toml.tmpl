[package]
name = "{{package}}"
version = "0.1.0"
edition = "2024"
publish = false

[dependencies]
# The server framework: {{features_doc}}. Another database: its feature (`sqlite`, `postgres`,
# `mysql`; any combination, `database.url` in config.toml picks one).
net_backend_server = { version = "{{version}}", default-features = false, features = [{{features}}] }
tokio = { version = "1", features = ["rt-multi-thread", "macros"] }
