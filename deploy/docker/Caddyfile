# Caddy in front of net_backend_server (Docker Compose): HTTPS + WSS for {$DOMAIN}, certificates
# from Let's Encrypt / ZeroSSL automatically (ports 80 and 443 must reach this machine).

{
	# The address for certificate expiry notices (ACME_EMAIL in .env).
	email {$ACME_EMAIL}
	servers {
		timeouts {
			read_header 15s
			idle 2m
		}
	}
}

{$DOMAIN} {
	# The storage module's batch put carries up to ~4.2 MB (4 MiB of values plus JSON). A site-wide
	# limit applies to every route, so it must allow the largest one.
	request_body {
		max_size 5MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	# Access log without credentials: Authorization / Cookie headers removed, a `token` query
	# parameter deleted (the server's `ws.query_token` is off; this guards against clients that send
	# it anyway).
	log {
		output stdout
		format filter {
			wrap json
			request>headers>Authorization delete
			request>headers>Cookie delete
			request>uri query {
				delete token
			}
		}
	}

	# HTTP and WebSocket (/v1/ws) to the server. Caddy adds X-Forwarded-For with the client's
	# address; the server trusts it only from this network (NBS__HTTP__TRUSTED_PROXIES).
	reverse_proxy server:8080 {
		# A configuration reload keeps open WebSockets for up to 5 minutes instead of closing them
		# all at once.
		stream_close_delay 5m
		transport http {
			dial_timeout 5s
		}
	}
}
