# Docker Compose settings (setup.sh writes .env from this file). Never commit .env or secrets/.

# The database, chosen at install time:
#   compose.yaml:compose.mysql.yaml     or     compose.yaml:compose.postgres.yaml
COMPOSE_FILE=compose.yaml:compose.mysql.yaml
# The separator above is ':' on every system (Docker on Windows would expect ';' without this line).
COMPOSE_PATH_SEPARATOR=:

# The public host name of the API (its DNS A / AAAA records point at this machine).
DOMAIN=api.example.com

# Where certificate expiry notices go.
ACME_EMAIL=admin@example.com

# The Caddy <-> server network (IPv4 + IPv6) and Caddy's fixed addresses in it. The server trusts
# X-Forwarded-For only from CADDY_IPV4 / CADDY_IPV6. Change all four together, and only if a subnet
# collides with a network on this machine (the addresses must lie inside their subnets).
EDGE_SUBNET=172.30.250.0/24
EDGE_SUBNET6=fd00:6e62:73::/64
CADDY_IPV4=172.30.250.10
CADDY_IPV6=fd00:6e62:73::10
