# /etc/net-backend/backup.env: settings of net-backend-backup / net-backend-restore.

# systemd: the server runs as the net-backend service (database URL from NBS_DATABASE_URL_FILE).
# docker:  the server runs with Docker Compose (database inside the `db` container).
NBS_BACKUP_MODE=systemd

# Where backups go, and how many days they are kept (0 = keep all).
NBS_BACKUP_DIR=/var/backups/net-backend
NBS_BACKUP_KEEP_DAYS=14

# systemd mode: the file holding the database URL.
NBS_DATABASE_URL_FILE=/etc/net-backend/database_url

# docker mode: the folder with compose.yaml, .env and secrets/.
NBS_COMPOSE_DIR=/opt/net_backend/deploy/docker
